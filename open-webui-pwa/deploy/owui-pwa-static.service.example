[Unit]
Description=Open WebUI PWA overlay (manifest + icons on localhost, fronted by tailscale serve)

[Service]
Type=simple
# Directory layout (see ../README.md):
#   manifest.json  icon-192.png  icon-512.png  static/{favicon,logo,apple-touch-icon,splash}.png
ExecStart=/usr/bin/python3 -m http.server 9131 --bind 127.0.0.1 --directory %h/.local/share/owui-pwa
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
